# Copy this file to ".env" (same folder) and fill in real values.
# .env is in .gitignore -- never commit real keys.

# Get a NEW key at https://console.groq.com/keys (the old one was committed to config.py and must be revoked)
GROQ_API_KEY=

# Any long random string, e.g. output of:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional: how long logins last. Defaults: 60 minutes, or 7 days with "Keep me signed in".
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REMEMBER_ME_EXPIRE_DAYS=7
